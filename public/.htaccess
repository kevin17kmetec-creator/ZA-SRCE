# Apache-Konfiguration für die React-Seite (SPA) auf dem A1-Hosting
DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ordner "zasebno" (Konfiguration mit Schlüsseln) niemals ausliefern
    RewriteRule ^zasebno(/|$) - [F,L]

    # Alter Pfad /api/pdf -> neuer PHP-Proxy
    RewriteRule ^api/pdf/?$ api/pdf.php [L,QSA]

    # Vorhandene Dateien und Ordner (z. B. /statistika/, /api/*.php) direkt ausliefern
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Alle anderen Adressen an die React-App übergeben
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
